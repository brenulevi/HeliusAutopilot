{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Firmware (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Firmware/Firmware.elf",
            "gdbPath": "${env:HOME}/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "serverpath": "${env:HOME}/.local/share/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${env:HOME}/.local/share/stm32cube/bundles/programmer/2.23.0/bin",
            "device": "STM32F411RE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${env:HOME}/.local/share/stm32cube/packs/STMicroelectronics/stm32f4xx_dfp/1.2.0/SVD/STM32F411.svd"
        }
    ]
}
