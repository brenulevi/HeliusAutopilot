{
    "version": 3,
    "configurePresets": [
        {
            "name": "jsbsim",
            "binaryDir": "${sourceDir}/build/jsbsim",
            "cacheVariables": {
                "BUILD_TARGET": "JSBSIM",
                "HELIUS_MATH_BACKEND": "SCALAR"
            }
        },
        {
            "name": "stm32",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32",
		    "toolchainFile": "${sourceDir}/firmware/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "BUILD_TARGET": "STM32",
                "HELIUS_MATH_BACKEND": "SCALAR"
            }
        },
        {
            "name": "stm32-cmsis",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-cmsis",
		    "toolchainFile": "${sourceDir}/firmware/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "BUILD_TARGET": "STM32",
                "HELIUS_MATH_BACKEND": "CMSIS"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "jsbsim",
            "configurePreset": "jsbsim",
            "jobs": 8
        },
        {
            "name": "stm32",
            "configurePreset": "stm32",
            "jobs": 8
        },
        {
            "name": "stm32-cmsis",
            "configurePreset": "stm32-cmsis",
            "jobs": 8
        }
    ]
}